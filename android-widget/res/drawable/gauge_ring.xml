<?xml version="1.0" encoding="utf-8"?>
<!--
  Progress drawable usado como "anillo" del widget Gauge.
  Truco simple: dos rectángulos con esquinas redondeadas para fingir un arco
  horizontal grueso (los RemoteViews no soportan dibujos circulares custom).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#1F2937" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="#22C55E" android:endColor="#86EFAC" android:angle="0" />
                <corners android:radius="60dp" />
            </shape>
        </clip>
    </item>
</layer-list>
