<?xml version="1.0" encoding="utf-8"?>
<!-- WAVE — Tarjeta estilo "CPU 96%": % batería gigante + gráfico de onda decorativo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/wave_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Batería"
            android:textColor="#E5E7EB"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_battery_bolt" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">
        <TextView
            android:id="@+id/wave_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="%"
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:paddingTop="16dp"
            android:paddingStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wave_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="estado"
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/wave_graph"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:src="@drawable/wave_green"
        android:scaleType="fitXY"
        android:layout_marginTop="4dp" />

    <ProgressBar
        android:id="@+id/wave_pulse"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="#22C55E" />
</LinearLayout>
