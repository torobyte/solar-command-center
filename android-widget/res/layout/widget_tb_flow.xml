<?xml version="1.0" encoding="utf-8"?>
<!-- TOROBYTE — Widget 4x2 FLUJO de energía: Solar → Casa, Bat ↔ Casa, Red ↔ Casa -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:background="@drawable/tb_widget_bg"
    android:orientation="vertical">

    <!-- Header row with state pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FLUJO DE ENERGÍA"
            android:textColor="@color/tb_muted"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />
        <TextView
            android:id="@+id/tb_fl_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/tb_accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/tb_pill_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Diagram row: PV — arrow — HOME — arrow — GRID  (and BAT below HOME) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <!-- Solar node -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/tb_node_bg">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tb_sun" />
            </FrameLayout>
            <TextView android:id="@+id/tb_fl_pv"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/tb_fg"
                android:textSize="12sp" android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SOLAR" android:textColor="@color/tb_muted"
                android:textSize="8sp" android:letterSpacing="0.15" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tb_fl_arrow_pv"
            android:layout_width="22dp"
            android:layout_height="10dp"
            android:src="@drawable/tb_arrow_right" />

        <!-- Home / battery column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/tb_node_bg">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tb_home" />
            </FrameLayout>
            <TextView android:id="@+id/tb_fl_load"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/tb_fg"
                android:textSize="13sp" android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CONSUMO" android:textColor="@color/tb_muted"
                android:textSize="8sp" android:letterSpacing="0.15" />

            <!-- Battery row under home -->
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <ImageView
                    android:id="@+id/tb_fl_arrow_bat"
                    android:layout_width="20dp"
                    android:layout_height="10dp"
                    android:src="@drawable/tb_arrow_right" />
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_tb_bolt"
                    android:layout_marginStart="2dp" />
                <TextView android:id="@+id/tb_fl_bat"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/tb_fg"
                    android:textSize="11sp" android:textStyle="bold"
                    android:paddingStart="3dp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/tb_fl_arrow_grid"
            android:layout_width="22dp"
            android:layout_height="10dp"
            android:src="@drawable/tb_arrow_left" />

        <!-- Grid node -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/tb_node_bg">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tb_grid" />
            </FrameLayout>
            <TextView android:id="@+id/tb_fl_grid"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/tb_fg"
                android:textSize="12sp" android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RED" android:textColor="@color/tb_muted"
                android:textSize="8sp" android:letterSpacing="0.15" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
