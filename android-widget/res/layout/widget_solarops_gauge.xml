<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante GAUGE — gran arco circular con % batería + métricas laterales.
  Drop into: android/app/src/main/res/layout/widget_solarops_gauge.xml
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/gauge_site"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SolarOps"
        android:textColor="#FAFAFA"
        android:textSize="12sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ProgressBar
            android:id="@+id/gauge_ring"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/gauge_ring"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/gauge_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/gauge_pv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☀ —"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:gravity="center" />
        <TextView
            android:id="@+id/gauge_load"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ —"
            android:textColor="#60A5FA"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
