<?xml version="1.0" encoding="utf-8"?>
<!-- TOROBYTE — Widget 2x2 ANILLO: arco circular + % grande al centro. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@drawable/tb_widget_bg">

    <!-- Arco -->
    <ImageView
        android:id="@+id/tb_rg_arc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/gauge_arc_00" />

    <!-- Centro: % + estado + autonomía -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:id="@+id/tb_rg_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/tb_fg"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="@color/tb_muted"
                android:textSize="14sp"
                android:paddingBottom="6dp"
                android:paddingStart="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tb_rg_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/tb_accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/tb_rg_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/tb_muted"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</FrameLayout>
