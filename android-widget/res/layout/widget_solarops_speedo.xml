<?xml version="1.0" encoding="utf-8"?>
<!-- SPEEDO — Tarjeta 4x2 estilo "Mbps": arco gauge enorme para potencia PV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_solar_panel" />
        <TextView
            android:id="@+id/speedo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Producción solar"
            android:textColor="#E5E7EB"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/speedo_site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/speedo_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="W"
            android:textColor="#FACC15"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="14dp"
            android:paddingStart="4dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/speedo_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/speedo_bar"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="0" android:textColor="#6B7280" android:textSize="9sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="kW" android:textColor="#9CA3AF" android:textSize="9sp" />
        <TextView
            android:id="@+id/speedo_max"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="máx" android:textColor="#6B7280" android:textSize="9sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/speedo_pulse"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="#FACC15"
        android:layout_marginTop="4dp" />
</LinearLayout>
