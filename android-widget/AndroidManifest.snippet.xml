<!--
  Snippet para fusionar en android/app/src/main/AndroidManifest.xml dentro de <application>.
  TOROBYTE — solo 4 widgets oficiales (4x2 principal, 4x1 resumen, 2x2 batería, 1x1 batería).
-->

<activity
    android:name="app.solarops.client.WidgetSetupActivity"
    android:exported="false"
    android:label="Configurar widget" />

<!-- TOROBYTE — 4x2 Principal -->
<receiver android:name="app.solarops.client.TbWidgetMain" android:exported="true" android:label="TOROBYTE · 4x2 Principal">
    <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tb_main_info" />
</receiver>

<!-- TOROBYTE — 4x1 Resumen -->
<receiver android:name="app.solarops.client.TbWidgetSummary" android:exported="true" android:label="TOROBYTE · 4x1 Resumen">
    <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tb_summary_info" />
</receiver>

<!-- TOROBYTE — 2x2 Batería -->
<receiver android:name="app.solarops.client.TbWidgetBattery2x2" android:exported="true" android:label="TOROBYTE · 2x2 Batería">
    <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tb_battery_2x2_info" />
</receiver>

<!-- TOROBYTE — 1x1 Batería -->
<receiver android:name="app.solarops.client.TbWidgetBattery1x1" android:exported="true" android:label="TOROBYTE · 1x1 Batería">
    <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tb_battery_1x1_info" />
</receiver>

<activity
    android:name="app.solarops.client.WidgetConfigActivity"
    android:exported="true"
    android:theme="@android:style/Theme.DeviceDefault.Dialog">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
    </intent-filter>
</activity>

<service
    android:name="app.solarops.client.WidgetStreamService"
    android:exported="false"
    android:foregroundServiceType="dataSync" />

<service
    android:name="app.solarops.client.LockscreenLiveService"
    android:exported="false"
    android:foregroundServiceType="dataSync" />

<service
    android:name="app.solarops.client.AlertsStreamService"
    android:exported="false"
    android:foregroundServiceType="dataSync" />
