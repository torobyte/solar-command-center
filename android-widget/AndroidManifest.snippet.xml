<!--
  Snippet para fusionar en android/app/src/main/AndroidManifest.xml dentro de <application>.
  Requiere:
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
-->

<activity
    android:name="app.solarops.client.WidgetSetupActivity"
    android:exported="false"
    android:label="Configurar widget" />

<!-- Variante 1 — Compacto -->
<receiver android:name="app.solarops.client.SolarOpsWidget" android:exported="true" android:label="Compacto">
    <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_solarops_info" />
</receiver>

